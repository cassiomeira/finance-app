# Banco de dados PostgreSQL (colify)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financeapp
DB_USER=financeapp_user
DB_PASSWORD=sua_senha_aqui

# JWT
JWT_SECRET=troque_por_uma_chave_secreta_bem_longa_aqui
JWT_EXPIRES_IN=7d

# Servidor
PORT=3001
NODE_ENV=production

# Admin email (receberá role de admin automaticamente)
ADMIN_EMAIL=cassiomeiraelis@gmail.com

# Stripe (opcional - para assinaturas premium)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_AMOUNT=1990

# URL do frontend (para redirects do Stripe)
FRONTEND_URL=https://seu-dominio-gerado-pelo-colify.com

# Upload de arquivos
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
