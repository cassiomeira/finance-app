# Banco de dados PostgreSQL (colify)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financeapp
DB_USER=financeapp_user
DB_PASSWORD=sua_senha_aqui

# JWT (OBRIGATÓRIO — o servidor não sobe sem isto, >= 16 caracteres)
JWT_SECRET=troque_por_uma_chave_secreta_bem_longa_aqui
JWT_EXPIRES_IN=7d

# Servidor
PORT=3001
NODE_ENV=production

# CORS — domínios permitidos (separados por vírgula). Defina em produção!
# Se vazio, cai para FRONTEND_URL; se ambos vazios, CORS fica aberto (só dev).
CORS_ORIGINS=https://app.seu-dominio.com

# Admin email (receberá role de admin automaticamente)
ADMIN_EMAIL=cassiomeiraelis@gmail.com

# IA — chave do Google Gemini (fica SÓ no servidor, nunca no frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Stripe (para assinaturas premium)
STRIPE_SECRET_KEY=
# OBRIGATÓRIO para o webhook funcionar (sem ele o webhook é rejeitado)
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_AMOUNT=1990

# URL do frontend (para redirects do Stripe)
FRONTEND_URL=https://seu-dominio-gerado-pelo-colify.com

# Upload de arquivos
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Limites do plano gratuito (opcional — valores padrão abaixo)
FREE_TRANSACTION_LIMIT=50
FREE_CARD_LIMIT=1
MIN_PASSWORD_LENGTH=8

# Rate limiting (opcional — requisições por janela)
RATE_LIMIT_API=300
RATE_LIMIT_AUTH=10
RATE_LIMIT_AI=15
